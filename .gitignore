# An allowlist: only release-owned paths are tracked. The owner's library, sources and research never are.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/CHANGELOG.md
!/LESSONS.md
!/package.json
!/.claude-plugin/
!/plugin/
!/test/
!/scripts/
!/docs/
!/assets/
# Machine-local launch file the Codex install writes.
.mcp.json
*.secret
*.key
.env
.env.*
