# Root allowlist separates the reusable code from private historical acceptance data.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/CHANGELOG.md
!/LESSONS.md
!/package.json
!/package-lock.json
!/requirements.lock.txt
!/tsconfig.json
!/src/
!/contracts/
!/config/
!/plugin/
!/test/
!/scripts/
!/docs/
!/assets/
/plugin/.mcp.json
/scripts/*
!/scripts/configure-plugin.mjs
!/scripts/install-plugin.mjs
!/scripts/package-plugin.mjs
!/scripts/check-release.mjs
!/scripts/generate-types.mjs
!/scripts/patch-falkordb.mjs
!/scripts/convert.py
!/scripts/pdf_extract.py
!/scripts/visual_assets.py
!/scripts/render-svg.mjs
!/scripts/contact-sheets.py
!/scripts/graph-service.ps1
!/scripts/graph-service.sh
!/scripts/setup-wsl.sh
!/scripts/kill-worker.ts
**/__pycache__/
*.pyc
*.secret
.env
.env.*
!.env.example
