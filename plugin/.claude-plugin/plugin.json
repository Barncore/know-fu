{
  "name": "know-fu",
  "displayName": "Know Fu",
  "version": "0.7.0",
  "description": "A local research library your agent compiles from books, papers and videos, then explains, applies and invents from.",
  "author": {
    "name": "Know Fu"
  },
  "license": "MIT",
  "repository": "https://github.com/Barncore/know-fu",
  "keywords": ["research", "knowledge", "library", "mcp"],
  "mcpServers": {
    "know-fu": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs"],
      "env": {
        "KB_PROJECT": "${CLAUDE_PROJECT_DIR}",
        "KB_ACTOR": "claude"
      }
    }
  }
}
