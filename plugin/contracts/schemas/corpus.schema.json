{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/research-kb/spec/corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "integration": {
      "enum": [
        "mcp",
        "codex",
        "claude"
      ],
      "description": "The agent adapter a library was set up for: mcp when any MCP agent may use it. Informational; project bindings and the access policy decide access."
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "module_id",
          "title",
          "description"
        ]
      },
      "minItems": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "domain_id",
          "title"
        ]
      },
      "minItems": 1
    },
    "default_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "write_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "read_modules",
        "write_modules",
        "source_refs"
      ]
    },
    "project_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "read_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "write_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "description": "Modules this folder may save answers and ideas into and author in (ingest, notes, proposals, jobs). Also the default for administer_modules."
          },
          "save_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "description": "Optional. Modules this folder may file answers and keep ideas in. When absent, write_modules."
          },
          "author_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "description": "Optional. Modules this folder may ingest into, write notes in, and propose, advance and publish jobs for. When absent, write_modules."
          },
          "administer_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "description": "Optional. Modules this folder may administer: lifecycle changes, imports, and with every module, configuration, whole-library maintenance and evaluation. When absent, write_modules."
          }
        },
        "required": [
          "project_id",
          "read_modules",
          "write_modules"
        ]
      },
      "minItems": 1
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional access policy. Without it, only bound folders may use the library and each binding matches its folder exactly. With it, a binding also covers the folders inside its folder (the closest binding wins), and folders with no binding get any_project.",
      "properties": {
        "home_project": {
          "type": "string",
          "minLength": 1,
          "description": "The library's home folder. It needs its own binding; refusals name it as the place to ingest and administer."
        },
        "any_project": {
          "type": "object",
          "additionalProperties": false,
          "description": "What a folder with no binding of its own may do. It never administers.",
          "properties": {
            "read_modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "save_modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "author_modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "read_modules",
            "save_modules",
            "author_modules"
          ]
        }
      },
      "required": [
        "home_project"
      ]
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "title",
    "integration",
    "modules",
    "domains",
    "default_scope",
    "project_bindings"
  ]
}
