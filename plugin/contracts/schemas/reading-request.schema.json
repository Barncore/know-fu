{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/research-kb/spec/reading-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interface_version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "progressive"
    },
    "kind": {
      "enum": [
        "catalogue",
        "topic",
        "account",
        "accounts",
        "sections",
        "context"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "explain",
        "teach",
        "apply",
        "compare",
        "invent",
        "synthesize",
        "investigate"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "write_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "read_modules",
        "write_modules",
        "source_refs"
      ]
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "value"
        ]
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "record_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision"
        ]
      },
      "minItems": 1,
      "maxItems": 40
    },
    "section_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "context_offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "graph": {
      "type": "boolean"
    },
    "graph_required": {
      "type": "boolean"
    },
    "semantic": {
      "type": "boolean"
    },
    "rerank": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": [
        "query"
      ]
    },
    {
      "required": [
        "kind"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "topic"
            ]
          }
        }
      },
      "then": {
        "required": [
          "topic"
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "account",
              "sections"
            ]
          }
        }
      },
      "then": {
        "required": [
          "record_ref"
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "accounts",
              "context"
            ]
          }
        }
      },
      "then": {
        "required": [
          "record_refs"
        ]
      }
    }
  ]
}
