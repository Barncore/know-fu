{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/research-kb/spec/evaluation-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "condition": {
      "enum": [
        "no_kb",
        "source_only",
        "prose_and_passages",
        "full_system"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_setting": {
      "type": "string",
      "minLength": 1
    },
    "answer_budget": {
      "type": "integer",
      "minimum": 1
    },
    "tool_budget": {
      "type": "integer",
      "minimum": 0
    },
    "available_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "incomplete"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "answer_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "ambiguous",
              "not_scored"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "diagnosis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "revision"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "case_id",
          "answer_path",
          "verdict",
          "rationale",
          "diagnosis",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "corpus_id",
    "release_id",
    "case_ids",
    "condition",
    "fingerprint",
    "model",
    "model_version",
    "reasoning_setting",
    "answer_budget",
    "tool_budget",
    "available_tools",
    "status",
    "results",
    "limitations",
    "receipts"
  ]
}
